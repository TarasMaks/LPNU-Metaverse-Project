# ── Application ──────────────────────────────────────────────
APP_TITLE="Biometric Identity Service"
APP_VERSION="1.0.0"
DEBUG=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./biometric_identity.db

# ── Security ─────────────────────────────────────────────────
# Secret used to sign Verifiable Credentials (generate with: openssl rand -hex 32)
VC_SIGNING_KEY=change-me-to-a-random-64-hex-string
# AES-256 key for encrypting biometric templates (generate with: openssl rand -hex 32)
TEMPLATE_ENCRYPTION_KEY=change-me-to-a-random-64-hex-string
# API key required for service-to-service calls (leave empty to disable)
API_KEY=
# Rate-limit: requests per minute per client IP
RATE_LIMIT=60/minute

# ── Credential Lifetimes ─────────────────────────────────────
CHALLENGE_TTL_SECONDS=300
VC_TTL_SECONDS=600

# ── Blockchain (optional) ───────────────────────────────────
# JSON-RPC provider URL (e.g. Infura, Alchemy, local Hardhat/Ganache)
WEB3_PROVIDER_URL=
# Private key of the deployer / relayer account (hex, no 0x prefix)
BLOCKCHAIN_PRIVATE_KEY=
# Contract addresses (filled after deployment)
IDENTITY_REGISTRY_ADDRESS=
COMMITMENT_REGISTRY_ADDRESS=
POLICY_REGISTRY_ADDRESS=
AUDIT_LOG_ADDRESS=

# ── Biometric AI ─────────────────────────────────────────────
DEEPFACE_MODEL=ArcFace
DEEPFACE_DETECTOR=retinaface
DEEPFACE_DISTANCE_METRIC=cosine
FACE_MATCH_THRESHOLD=0.40
LIVENESS_BLUR_THRESHOLD=100.0
LIVENESS_MIN_FACE_RATIO=0.05

# ── Application ──────────────────────────────────────────────
APP_TITLE="Multi-Blockchain Service"
APP_VERSION="0.1.0"
DEBUG=false

# ── Blockchain Providers ────────────────────────────────────
# Ethereum JSON-RPC provider URL
ETH_PROVIDER_URL=
# Polygon JSON-RPC provider URL

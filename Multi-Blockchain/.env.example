# ── Application ──────────────────────────────────────────────
APP_TITLE="Multi-Blockchain Service"
APP_VERSION="1.0.0"
DEBUG=false

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./multi_blockchain.db

# ── Settlement Layer (L1) – Ethereum 2.0 / PoS ──────────────
# Ethereum JSON-RPC provider URL
ETH_PROVIDER_URL=
# Private key for signing L1 transactions (hex, no 0x prefix)
ETH_PRIVATE_KEY=
# Chain ID (1 = mainnet, 5 = goerli, 11155111 = sepolia)
ETH_CHAIN_ID=1
# Contract addresses (deployed on settlement layer)
SETTLEMENT_ANCHOR_ADDRESS=
IDENTITY_NFT_ADDRESS=
TRANSACTION_REGISTRY_ADDRESS=

# ── Execution Layer (L2) ────────────────────────────────────
# Layer-2 JSON-RPC provider URL
L2_PROVIDER_URL=
# Private key for signing L2 transactions (hex, no 0x prefix)
L2_PRIVATE_KEY=
# Chain ID (137 = Polygon, 42161 = Arbitrum, 8453 = Base)
L2_CHAIN_ID=137

# ── Middleware / RPC ─────────────────────────────────────────
# Comma-separated fallback RPC endpoints for load balancing
RPC_ENDPOINTS=
RPC_TIMEOUT_SECONDS=30
RPC_MAX_RETRIES=3

# ── IPFS ─────────────────────────────────────────────────────
# IPFS HTTP API URL (e.g. http://localhost:5001)
IPFS_API_URL=
# IPFS public gateway URL
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# ── Webhooks / Event-driven sync ─────────────────────────────
# Alchemy Notify webhook authentication token
ALCHEMY_NOTIFY_TOKEN=
# Callback URL for outgoing webhook registrations
WEBHOOK_CALLBACK_URL=

# ── PUF Identity ─────────────────────────────────────────────
PUF_HASH_ALGORITHM=sha256
NFT_METADATA_BASE_URI=

# ── Routing Policy ───────────────────────────────────────────
DEFAULT_INTEGRITY_THRESHOLD=0.7
DEFAULT_LATENCY_THRESHOLD_MS=2000
L2_MAX_DATA_SIZE_BYTES=1048576
